{
  "name": "infakt-sdk",
  "version": "0.1.2",
  "description": "TypeScript SDK for the inFakt.pl API (https://docs.infakt.pl/)",
  "type": "module",
  "packageManager": "bun@1.3.0",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "postman/collection.json",
    "README.md"
  ],
  "scripts": {
    "build": "vite build",
    "build:watch": "vite build --watch",
    "dev": "bun --watch dev/index.ts",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "typecheck": "tsc --noEmit -p tsconfig.check.json",
    "sync:postman": "bun scripts/sync-postman-collection.ts",
    "generate:modules": "bun scripts/generate-modules.ts",
    "prebuild": "bun run generate:modules",
    "docs:dev": "bun run --cwd docs dev",
    "docs:build": "bun run --cwd docs build"
  },
  "keywords": [
    "infakt",
    "infakt.pl",
    "api",
    "sdk",
    "invoicing",
    "accounting",
    "poland"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/orafal-dev/infakt-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/orafal-dev/infakt-sdk/issues"
  },
  "homepage": "https://github.com/orafal-dev/infakt-sdk#readme",
  "engines": {
    "bun": ">=1.1.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/node": "^22.15.21",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vite-plugin-dts": "^4.5.4"
  }
}
